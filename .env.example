# ---- required ----
DISCORD_TOKEN=
DISCORD_OWNER_ID=
# the application id from the developer portal, General Information tab.
# the oauth client_id and the invite url both come from it.
DISCORD_CLIENT_ID=
# the client secret from the developer portal, OAuth2 tab. required: the
# verification callback is a core feature and does not work without it.
OAUTH_CLIENT_SECRET=

# ---- database ----
# unset      -> ./data/snapback.duckdb
# postgres:// -> user:pass@host:5432/dbname
DATABASE_URL=

# ---- web / verification ----
# public base URL the OAuth redirect and button point at
PUBLIC_BASE_URL=https://example.com
PORT=8080
# unset -> plaintext (only acceptable behind a trusted local tunnel)
IP_STORAGE=hash                 # hash | encrypted | plaintext
IP_HASH_PEPPER=                 # required when IP_STORAGE=hash
# 32-byte base64 key, required when IP_STORAGE=encrypted or to encrypt tokens
ENCRYPTION_KEY=

# ---- captcha ----
# the challenge a person solves on the landing page before the OAuth flow
# starts. none | turnstile | recaptcha | cap
# turnstile (challenges.cloudflare.com) and cap (github.com/tiagozip/cap,
# self-hosted) are the two that do not hand a tracker a person's browser.
CAPTCHA_PROVIDER=none
# the public key the widget carries, and the private key the verifier takes.
# cap calls them the site key and the secret key; turnstile calls them the site
# key and the secret key; recaptcha v2 calls them the same.
CAPTCHA_SITE_KEY=
CAPTCHA_SECRET=
# cap only: the origin of your own instance, no trailing slash, e.g.
# https://cap.example.com. ignored by the other providers.
CAPTCHA_BASE_URL=

# ---- proxy awareness ----
# set to true when running behind Cloudflare Tunnel; the IP capture then
# trusts cf-connecting-ip and ignores x-forwarded-for
BEHIND_CLOUDFLARE_TUNNEL=false
TRUSTED_PROXY_DEPTH=0

# ---- intel ----
# local files only: no api key and no third party sees an address. the three
# below are fetched by the bot when INTEL_UPDATE is on; the mmdb is not, because
# db-ip hands its free downloads to a registered account.
DBIP_COUNTRY_MMDB=./data/dbip-country-lite.mmdb
IP2ASN_TSV=./data/ip2asn.tsv
AS_METADATA_JSON=./data/as-metadata.json
TOR_EXIT_LIST=./data/tor-exit-addresses.txt
INTEL_ENABLED=true
INTEL_UPDATE=true

# ---- limits ----
# message caps and the pull counters are per-guild settings now, edited from
# /setup backup and /pull config; they do not live in the environment.
MAX_CONCURRENT_JOBS=2

# ---- storage ----
BACKUP_DIR=./data/backups      # backups/<id>/assets/ lands here
EXPORT_DIR=./data/exports      # written export files land here, swept by expiry
MAX_ASSET_BYTES=8388608        # 8 MiB; a bigger asset is recorded, not downloaded. 0 keeps urls only

# ---- optional ----
LOG_LEVEL=info            # verbose | debug | info | warn | error
AUTOMATION_ENABLED=true   # false = scheduler off, every job is manual
MOBILE_STATUS=true        # identify as the phone client, so the bot wears the mobile badge
DISCORD_DEV_GUILD_ID=     # instant command registration while developing
