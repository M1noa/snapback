{
  "compilerOptions": {
    "target": "ESNext",
    // "preserve" is the current setting for a runtime that does its own
    // resolution: it implies moduleResolution bundler and leaves import syntax
    // alone for bun to handle.
    "module": "preserve",
    "moduleDetection": "force",
    "lib": ["ESNext"],
    "types": ["bun"],
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noUncheckedSideEffectImports": true,
    // bun strips types rather than compiling them, so every construct here has
    // to be erasable: no enums, no namespaces, no parameter properties.
    "erasableSyntaxOnly": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src", "tests", "scripts", "*.config.ts"]
}
